/*
 * monetization.js - AdMob interstitials + "remove ads" purchase.
 *
 * Active only when MOBILE_CONFIG.ads is true AND running inside the native
 * app (never on itch web/desktop). Everything is driven by two hooks:
 *
 *   window.showAdBreak()  - call from an RPG Maker event (Script command:
 *                           `window.showAdBreak && window.showAdBreak();`)
 *                           at natural break points (end of each day).
 *                           No-op if ads were removed, an ad isn't loaded
 *                           yet (e.g. offline), ads are disabled, or the
 *                           last ad was under minAdIntervalSec ago (3 min
 *                           by default).
 *                           Returning to the title screen ("To Title",
 *                           game over, the ending) is its own ad break
 *                           that ignores the cooldown: every return shows
 *                           an ad if one is loaded. Never on app start.
 *                           Games exported for the Game Monetize portal
 *                           call `window.sdk.showBanner()` at their ad
 *                           breaks instead; inside the app that object is
 *                           provided here and routes to showAdBreak(), so
 *                           one export serves both the portal and Play.
 *
 *   THE FIRST INTERSTITIAL IS REQUESTED ON THE FIRST MAP SCENE, not at app
 *   start. A launch that ends on the title screen (a look, a tester, a
 *   wrong tap) then costs no ad request, which kept the account's show rate
 *   near one impression in four; a player who reaches the map meant to play,
 *   and the ad is loaded seconds later - in time even for a save made just
 *   before a day's end. After each ad the next one is loaded at once.
 *
 *   While the native interstitial is up the game loop is stopped and the
 *   audio context suspended, then both resume when it is dismissed - the
 *   event that triggered the break continues exactly where it left off.
 *
 *   TEST-ads builds (MOBILE_CONFIG.testAds) show a small status line at the
 *   bottom of the screen with what the ad pipeline is doing - init, load,
 *   show results and why an ad break was skipped - since a phone has no
 *   console. Release builds never show it.
 *
 *   window.buyRemoveAds() - starts the purchase flow. Wired to the title
 *                           screen button; also callable from the console.
 *
 * Ownership of the remove-ads product is checked against Google Play before
 * AdMob is even started, so a player who owns remove-ads never causes an ad
 * request; it is re-checked whenever the app returns to the foreground
 * (Capacitor's App "resume" event - the WebView's visibilitychange does not
 * fire around the ad or Play activities on Android), with localStorage as the offline cache. When Play answers and
 * the product is NOT owned any more (refunded or revoked order), the cache
 * is dropped and ads come back; when Play cannot be reached the check is
 * retried with backoff and the cache stands meanwhile, so a paying player
 * offline stays ad-free.
 *
 * Every call into the billing plugin goes through one queue (see billing()):
 * the plugin keeps a single Play connection and each call begins by closing
 * the one before it, so two overlapping calls - e.g. the ownership check and
 * the price lookup at startup - race, and the loser comes back as
 * "disconnected". A player who owns remove-ads then saw ads whenever the
 * ownership check lost that race.
 *
 * Consent (EEA, UK, Switzerland and wherever else the account's AdMob message
 * applies) comes between that ownership check and AdMob: Google's consent form
 * shows if it is required, and AdMob starts only once the consent library says
 * ads can be requested. A player who owns remove-ads is never asked. The form
 * is never opened over gameplay, and a failed check never holds the game up:
 * see gatherConsent(). The form itself is configured in the AdMob console
 * (Privacy & messaging); without a published message there is nothing to show.
 *
 * TEST-ads builds also expose window.__adsDebug = { reset(), break(),
 * consentTest(hash), consentOff() } so the ad pipeline can be driven from a
 * DevTools console: reset() forgets the remove-ads entitlement for this
 * session, break() is an ad break, consentTest() makes this device act as if
 * it were in the EEA and forgets its answer from the next launch on (hash =
 * the test device id the consent library prints to logcat), consentOff() ends
 * that. Release builds never read that setting.
 */
(function() {
    "use strict";

    var CFG = window.MOBILE_CONFIG || {};
    var STORAGE_KEY = "tc_ads_removed";
    var CONSENT_DEBUG_KEY = "tc_consent_debug";

    // Always defined so game event scripts can call it unconditionally.
    window.showAdBreak = function() {};

    var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform &&
                      window.Capacitor.isNativePlatform());

    // Game Monetize compatibility: the builder strips the portal SDK out of
    // index.html (its ads must not show inside the app), so events that do
    // `window.sdk && window.sdk.showBanner && window.sdk.showBanner();` get
    // the same object with the native interstitial behind it. Defined on
    // every native build so an unguarded sdk.showBanner() never throws on
    // the itch flavor either - there it is just a no-op like showAdBreak.
    if (isNative && !window.sdk) {
        window.sdk = {
            showBanner: function() { window.showAdBreak(); }
        };
    }

    if (!CFG.ads || !isNative) {
        return;
    }

    var Plugins = window.Capacitor.Plugins || {};
    var AdMob = Plugins.AdMob;
    var Purchases = Plugins.NativePurchases;

    var adsRemoved = false;
    try { adsRemoved = localStorage.getItem(STORAGE_KEY) === "1"; } catch (e) { /* ignore */ }
    var adReady = false;
    var prepareAttempts = 0;
    var adShowing = false;
    var lastAdAt = 0;
    // Soft frequency cap: never two ads within this many seconds, even if
    // the game hits two ad breaks back-to-back (e.g. quick scene skips).
    var MIN_GAP_MS = (CFG.minAdIntervalSec || 180) * 1000;
    var removeAdsBtn = null;
    var privacyBtn = null;
    var priceLabel = CFG.removeAdsPriceLabel || "";

    // - test-build status line -
    var debugLines = [];
    var debugEl = null;
    function adDebug(msg) {
        console.log("[ads] " + msg);
        if (!CFG.testAds) return;
        var stamp = new Date().toTimeString().slice(0, 8);
        debugLines.push(stamp + " " + msg);
        if (debugLines.length > 6) debugLines.shift();
        if (!debugEl && document.body) {
            debugEl = document.createElement("div");
            debugEl.id = "tc-addebug";
            debugEl.style.cssText =
                "position:fixed;left:0;bottom:0;z-index:30;max-width:100vw;" +
                "padding:0.6vmin 1.2vmin;background:rgba(0,0,0,0.6);color:#9f9;" +
                "font:2.2vmin/1.3 monospace;white-space:pre;pointer-events:none;";
            document.body.appendChild(debugEl);
        }
        if (debugEl) debugEl.textContent = debugLines.join("\n");
    }

    function setAdsRemoved(reason) {
        adsRemoved = true;
        adDebug("ads removed (" + (reason || "purchase") + ") - no more ad breaks");
        try { localStorage.setItem(STORAGE_KEY, "1"); } catch (e) { /* ignore */ }
        if (removeAdsBtn) {
            removeAdsBtn.style.display = "none";
        }
        refreshMenuCommands();
    }

    // Play no longer reports the product as owned (refund / revoked order):
    // forget the cached entitlement so ads resume.
    function clearAdsRemoved(reason) {
        if (!adsRemoved) return;
        adsRemoved = false;
        try { localStorage.removeItem(STORAGE_KEY); } catch (e) { /* ignore */ }
        adDebug("ads restored (" + reason + ")");
        if (removeAdsBtn) {
            removeAdsBtn.style.display = "";
        }
        refreshMenuCommands();
        startAds();
    }

    // Drop the "Remove Ads" entry from an open menu once ads are gone.
    function refreshMenuCommands() {
        try {
            var scene = window.SceneManager && SceneManager._scene;
            if (scene && scene._commandWindow && scene._commandWindow.refresh) {
                scene._commandWindow.refresh();
            }
        } catch (e) { /* ignore */ }
    }

    // - pause/resume game audio while the native ad covers the WebView -
    function suspendAudio() {
        try {
            if (window.WebAudio && WebAudio._context && WebAudio._context.state === "running") {
                WebAudio._context.suspend();
            }
        } catch (e) { /* ignore */ }
    }

    function resumeAudio() {
        try {
            if (window.WebAudio && WebAudio._context && WebAudio._context.state === "suspended") {
                WebAudio._context.resume();
            }
        } catch (e) { /* ignore */ }
    }

    // - freeze the game while the native ad covers it -
    // The interstitial is its own Android activity. The WebView keeps
    // ticking for a few frames before it opens and, on some devices, under
    // it, so everything the event does after the ad break (fade-in, the
    // next scene's dialogue) would play unseen. Stop the engine's game loop
    // (MZ: Graphics.stopGameLoop, MV: SceneManager._stopped) for the ad's
    // duration and restart it on dismissal.
    var gamePaused = false;
    var pauseWatchdog = null;
    // If the SDK never reports the ad as shown (silent failure), do not
    // leave the game frozen: give up after this long and carry on.
    var SHOW_TIMEOUT_MS = 8000;

    function pauseGame() {
        if (gamePaused) return;
        gamePaused = true;
        suspendAudio();
        try {
            if (window.SceneManager && typeof SceneManager.stop === "function") {
                SceneManager.stop();
            }
        } catch (e) { /* ignore */ }
    }

    function resumeGame() {
        if (pauseWatchdog) {
            clearTimeout(pauseWatchdog);
            pauseWatchdog = null;
        }
        if (!gamePaused) return;
        gamePaused = false;
        try {
            if (window.SceneManager && typeof SceneManager.resume === "function") {
                SceneManager.resume();
            }
        } catch (e) { /* ignore */ }
        resumeAudio();
    }

    // - interstitial ads ---------
    var adLoading = false;
    // True from the show call until the ad is dismissed (or failed to show).
    // The native plugin keeps ONE loaded interstitial per ad unit and drops
    // that slot when the ad on screen is dismissed - so an ad loaded while
    // another is showing is deleted on dismissal while this script would
    // still count it as ready, and the next break has nothing to show. No
    // load starts while an ad is up; the dismissed handler loads the next.
    var showPending = false;
    var retryTimer = null;
    function prepareNext() {
        if (adsRemoved || !AdMob || !consentOk) return;
        // One load at a time, and none while an ad is already waiting:
        // several paths (init, ads restored, a skipped break) may ask.
        if (adReady || adLoading) return;
        if (showPending || adShowing) {
            adDebug("load deferred: an ad is on screen");
            return;
        }
        if (retryTimer) {
            clearTimeout(retryTimer);
            retryTimer = null;
        }
        adLoading = true;
        adDebug("loading interstitial" + (CFG.testAds ? " (test unit)" : "") + "...");
        AdMob.prepareInterstitial({
            adId: CFG.interstitialAdUnitId,
            isTesting: !!CFG.testAds
        }).then(function() {
            adLoading = false;
            adReady = true;
            prepareAttempts = 0;
            adDebug("interstitial loaded - ready for the next ad break");
        }).catch(function(e) {
            adLoading = false;
            adReady = false;
            console.warn("Interstitial failed to load:", e && e.message);
            adDebug("load failed (try " + (prepareAttempts + 1) + "): " + ((e && e.message) || e));
            // Loads fail transiently on some devices (outdated Android System
            // WebView -> "Unable to obtain a JavascriptEngine", flaky network,
            // ad-blocking DNS). Retry with backoff so a later ad break still
            // has an ad ready.
            if (++prepareAttempts <= 5) {
                if (retryTimer) clearTimeout(retryTimer);
                retryTimer = setTimeout(function() {
                    retryTimer = null;
                    prepareNext();
                }, 30000 * prepareAttempts);
            }
        });
    }

    // - consent -----------------
    // Runs after Play has been asked about remove-ads and before AdMob starts.
    // consentOk is the consent library's own canRequestAds answer, and nothing
    // loads an ad without it. A failed check is treated as "not yet": the game
    // carries on with no ad requests and the check is tried again.
    //
    // The form is a dialog over the running game, so it only ever opens before
    // play starts (boot and title screens). If one turns out to be required
    // later (the first check failed offline, then the signal came back), it
    // waits for the next title screen or launch. Until then a player whose
    // earlier answer still stands keeps canRequestAds = true and sees ads.
    //
    // Nothing is frozen while the form is up: a form that never loads must
    // not be able to hang the game. It can only delay the ads.
    var CONSENT_TIMEOUT_MS = 20000;
    var consentOk = false;
    var consentSettled = false; // answered, and no form still waiting
    var consentBusy = null;
    var consentAttempts = 0;
    var consentRetryTimer = null;
    var playAsked = false; // the first remove-ads check has finished
    var privacyRequired = false;

    function consentOptions() {
        if (!CFG.testAds) return {};
        var hash = null;
        try { hash = localStorage.getItem(CONSENT_DEBUG_KEY); } catch (e) { /* ignore */ }
        if (!hash) return {};
        adDebug("consent test mode: acting as EEA");
        return { debugGeography: 1, testDeviceIdentifiers: [hash] };
    }

    function consentFormSafeNow() {
        if (adShowing || showPending) return false;
        if (!window.SceneManager || !window.Scene_Title) return true; // still booting
        var scene = SceneManager._scene;
        return !scene || scene instanceof Scene_Title ||
               (!!window.Scene_Boot && scene instanceof Scene_Boot);
    }

    function applyConsent(info) {
        consentOk = !!(info && info.canRequestAds);
        var wasRequired = privacyRequired;
        privacyRequired = !!(info && info.privacyOptionsRequirementStatus === "REQUIRED");
        adDebug("consent: " + (info && info.status) + ", can request ads: " + consentOk +
                ", privacy options " + (privacyRequired ? "required" : "not required"));
        if (privacyRequired !== wasRequired) refreshMenuCommands();
        if (consentOk) initAds();
    }

    function requestConsentInfo() {
        return new Promise(function(resolve, reject) {
            var timer = setTimeout(function() {
                reject(new Error("consent check timed out after " + (CONSENT_TIMEOUT_MS / 1000) + "s"));
            }, CONSENT_TIMEOUT_MS);
            AdMob.requestConsentInfo(consentOptions()).then(function(info) {
                clearTimeout(timer);
                resolve(info);
            }, function(e) {
                clearTimeout(timer);
                reject(e);
            });
        });
    }

    function retryConsentLater() {
        if (consentRetryTimer || ++consentAttempts > 5) return;
        consentRetryTimer = setTimeout(function() {
            consentRetryTimer = null;
            startAds();
        }, 30000 * consentAttempts);
    }

    // Resolves (never rejects) once this attempt is over. Concurrent callers
    // share one attempt.
    function gatherConsent() {
        if (consentBusy) return consentBusy;
        adDebug("checking consent...");
        consentBusy = requestConsentInfo().then(function(info) {
            if (info.status === "REQUIRED" && info.isConsentFormAvailable) {
                if (consentFormSafeNow()) {
                    adDebug("showing the consent form");
                    return AdMob.showConsentForm();
                }
                adDebug("consent form waits for the next title screen");
                consentSettled = false;
                applyConsent(info);
                return null;
            }
            return info;
        }).then(function(info) {
            consentBusy = null;
            consentAttempts = 0;
            if (info) {
                consentSettled = true;
                applyConsent(info);
            }
        }).catch(function(e) {
            consentBusy = null;
            console.warn("Consent check failed:", e && e.message);
            adDebug("consent check failed: " + ((e && e.message) || e) + " - no ad requests for now");
            retryConsentLater();
        });
        return consentBusy;
    }

    // The way into consent and AdMob for every path that wants ads on. Needs
    // the first remove-ads answer, so a player who owns it is never asked.
    function startAds() {
        if (!playAsked || adsRemoved || !AdMob) return;
        if (consentSettled) {
            initAds();
            return;
        }
        gatherConsent();
    }

    // Google requires a way back to the consent choice wherever the library
    // says one is needed: a title-screen button and a menu command, both only
    // shown then. A changed answer applies from the next ad request on.
    function showPrivacyOptions() {
        if (!AdMob) return;
        AdMob.showPrivacyOptionsForm().catch(function(e) {
            console.warn("Privacy options failed:", e && e.message);
            adDebug("privacy options failed: " + ((e && e.message) || e));
        }).then(function() {
            return gatherConsent();
        });
    }

    // Starts AdMob. Only ever runs once Play has been asked about remove-ads
    // (see start()), consent allows it (see gatherConsent) and ads are on: a paying player never starts
    // the SDK, so never causes an ad request. The first interstitial is NOT
    // loaded here but on the first map scene (see patchMap): until then no
    // request is made. Safe to call again (ads restored after a refund): the
    // SDK is initialized once, and a later call loads the next ad if the
    // player is already past the title screen.
    var adsStarted = false;
    var mapReached = false;
    function initAds() {
        if (!AdMob) {
            console.warn("AdMob plugin not available");
            return;
        }
        if (adsRemoved) {
            adDebug("ads removed - AdMob not started, no ad requests");
            return;
        }
        if (!consentOk) {
            adDebug("no consent to request ads - AdMob not started");
            return;
        }
        if (adsStarted) {
            if (mapReached) prepareNext();
            return;
        }
        adsStarted = true;
        AdMob.addListener("interstitialAdShowed", function() {
            adShowing = true;
            adDebug("ad is showing");
            // The ad is up: the watchdog is no longer needed, and the game
            // must stay frozen for as long as the ad is on screen.
            if (pauseWatchdog) {
                clearTimeout(pauseWatchdog);
                pauseWatchdog = null;
            }
            pauseGame();
        });
        AdMob.addListener("interstitialAdDismissed", function() {
            adShowing = false;
            showPending = false;
            adReady = false; // the plugin dropped its loaded ad on dismissal
            adDebug("ad dismissed - game resumed");
            resumeGame();
            prepareNext();
        });
        AdMob.addListener("interstitialAdFailedToShow", function(e) {
            adShowing = false;
            showPending = false;
            adReady = false;
            adDebug("show failed: " + ((e && e.message) || JSON.stringify(e)));
            resumeGame();
            prepareNext();
        });
        AdMob.initialize({ initializeForTesting: !!CFG.testAds })
            .then(function() {
                adDebug("AdMob initialized - first ad loads on the first map scene");
                // Ads restored (or Play slow to answer) with the player already
                // in the game: load now, there is no map entry still to come.
                if (mapReached) prepareNext();
            })
            .catch(function(e) {
                console.warn("AdMob init failed:", e && e.message);
                adDebug("init failed: " + ((e && e.message) || e));
            });
    }

    // opts.force: ignore the frequency cap (title-screen returns). Everything
    // else still applies - no ad without a loaded interstitial.
    window.showAdBreak = function(opts) {
        var force = !!(opts && opts.force);
        if (adsRemoved) { adDebug("ad break skipped: ads removed"); return; }
        if (adShowing) { adDebug("ad break skipped: an ad is already showing"); return; }
        if (!AdMob) { adDebug("ad break skipped: AdMob plugin missing"); return; }
        if (!force && Date.now() - lastAdAt < MIN_GAP_MS) {
            adDebug("ad break skipped: last ad " + Math.round((Date.now() - lastAdAt) / 1000) +
                    "s ago, minimum gap " + (MIN_GAP_MS / 1000) + "s");
            return;
        }
        if (!adReady) {
            adDebug("ad break skipped: no interstitial loaded yet - loading for the next one");
            prepareNext(); // try again for the next break (e.g. was offline)
            return;
        }
        adDebug("ad break: showing interstitial");
        adReady = false;
        showPending = true;
        lastAdAt = Date.now();
        // Freeze right now, before the ad activity opens, so the event that
        // called us does not run on for the frames in between.
        pauseGame();
        pauseWatchdog = setTimeout(function() {
            pauseWatchdog = null;
            if (!adShowing) {
                console.warn("Interstitial never reported as shown; resuming game");
                adDebug("ad never appeared within " + (SHOW_TIMEOUT_MS / 1000) + "s - game resumed");
                showPending = false;
                resumeGame();
                prepareNext();
            }
        }, SHOW_TIMEOUT_MS);
        AdMob.showInterstitial().catch(function(e) {
            console.warn("Interstitial failed to show:", e && e.message);
            adDebug("show rejected: " + ((e && e.message) || e));
            adShowing = false;
            showPending = false;
            if (pauseWatchdog) {
                clearTimeout(pauseWatchdog);
                pauseWatchdog = null;
            }
            resumeGame();
            prepareNext();
        });
    };

    // - one billing call at a time --------
    // @capgo/native-purchases holds a single BillingClient and every call
    // (getPurchases, getProduct, purchaseProduct) starts by closing whatever
    // connection the previous call still has in flight. Calls therefore must
    // never overlap: each one waits for the previous to settle. A per-call
    // timeout keeps a call that never settles from blocking the queue (and
    // the Remove Ads button) for good.
    var QUERY_TIMEOUT_MS = 20000;
    var PURCHASE_TIMEOUT_MS = 10 * 60 * 1000; // the player may sit on the Play sheet
    var billingQueue = Promise.resolve();
    function noop() {}
    function billing(task, timeoutMs) {
        var run = billingQueue.then(function() {
            return new Promise(function(resolve, reject) {
                var settled = false;
                var timer = setTimeout(function() {
                    if (settled) return;
                    settled = true;
                    reject(new Error("billing call timed out after " + (timeoutMs / 1000) + "s"));
                }, timeoutMs);
                Promise.resolve().then(task).then(function(v) {
                    if (settled) return;
                    settled = true;
                    clearTimeout(timer);
                    resolve(v);
                }, function(e) {
                    if (settled) return;
                    settled = true;
                    clearTimeout(timer);
                    reject(e);
                });
            });
        });
        billingQueue = run.then(noop, noop);
        return run;
    }

    // - remove-ads ownership --------
    // Resolves (never rejects) once Play has answered or the attempt failed;
    // a failed attempt schedules a retry. Concurrent callers share one check.
    var OWNED_RETRY_MS = [3000, 10000, 30000];
    var ownedCheck = null;
    var lastOwnedCheckAt = 0;
    function checkOwned(attempt) {
        if (!Purchases) return Promise.resolve();
        if (ownedCheck) return ownedCheck;
        attempt = attempt || 0;
        lastOwnedCheckAt = Date.now();
        ownedCheck = billing(function() {
            return Purchases.getPurchases({ productType: "inapp" });
        }, QUERY_TIMEOUT_MS).then(function(res) {
            ownedCheck = null;
            var owned = ((res && res.purchases) || []).some(function(t) {
                return t.productIdentifier === CFG.removeAdsProductId;
            });
            if (owned) {
                setAdsRemoved("remove_ads owned on this Google account");
            } else if (adsRemoved) {
                clearAdsRemoved("Play no longer reports remove_ads as owned");
            } else {
                adDebug("Play purchases checked: remove-ads not owned");
            }
        }).catch(function(e) {
            ownedCheck = null;
            console.warn("getPurchases failed:", e && e.message);
            adDebug("purchase check failed: " + ((e && e.message) || e));
            if (attempt < OWNED_RETRY_MS.length) {
                adDebug("retrying purchase check in " + (OWNED_RETRY_MS[attempt] / 1000) + "s");
                setTimeout(function() { checkOwned(attempt + 1); }, OWNED_RETRY_MS[attempt]);
            }
        });
        return ownedCheck;
    }

    // Re-check when the app comes back to the foreground: the player may
    // have bought, restored or been refunded outside this session (or in
    // the Play sheet that just closed). Capacitor's App plugin is the
    // reliable signal on Android - the WebView's visibilitychange does not
    // fire when the ad or Play activity covers and uncovers the game.
    // Throttled so a quick flip does not spam Play.
    function onForeground() {
        if (Date.now() - lastOwnedCheckAt < 15000) return;
        checkOwned();
        startAds();
    }
    document.addEventListener("visibilitychange", function() {
        if (document.visibilityState === "visible") onForeground();
    });
    if (Plugins.App && typeof Plugins.App.addListener === "function") {
        Plugins.App.addListener("resume", onForeground);
    }

    function buyRemoveAds() {
        if (!Purchases) {
            alert("Billing is not available on this device.");
            return;
        }
        billing(function() {
            return Purchases.purchaseProduct({
                productIdentifier: CFG.removeAdsProductId,
                productType: "inapp"
            });
        }, PURCHASE_TIMEOUT_MS).then(function() {
            setAdsRemoved("just purchased");
            alert("Ads removed. Thank you for the support!");
        }).catch(function(e) {
            var msg = (e && e.message) || String(e);
            // Capacitor passes the plugin's reject code separately; for an
            // owned product the plugin says "Purchase is not purchased" with
            // code ITEM_ALREADY_OWNED, so the message alone is not enough.
            var code = String((e && e.code) || "");
            if (/ITEM_ALREADY_OWNED/i.test(code) || /already|owned/i.test(msg)) {
                setAdsRemoved("already owned");
                alert("Purchase restored - ads removed!");
                return;
            }
            if (/USER_CANCELED/i.test(code) || /cancel/i.test(msg)) return;
            // Anything else: Play's purchase list is the truth - ask it
            // before telling the player the purchase failed.
            adDebug("purchase failed (" + (code || "no code") + "): " + msg);
            checkOwned().then(function() {
                if (!adsRemoved) alert("Purchase failed: " + msg);
            });
        });
    }
    window.buyRemoveAds = buyRemoveAds;

    // The game's touch layer must never see a tap on these buttons.
    function swallowTouches(el) {
        ["touchstart", "touchmove", "touchend", "mousedown", "mouseup", "contextmenu"]
            .forEach(function(t) {
                el.addEventListener(t, function(e) {
                    e.stopPropagation();
                    if (e.cancelable && (t.indexOf("touch") === 0 || t === "contextmenu")) {
                        e.preventDefault();
                    }
                }, { passive: false });
            });
    }

    // - title-screen "Remove Ads" button -------
    function buildButton() {
        var style = document.createElement("style");
        style.textContent =
            "#tc-removeads {" +
            "  position: fixed; right: 2.5vmin; top: 2.5vmin;" +
            "  z-index: 21; padding: 2vmin 4vmin; border-radius: 5vmin;" +
            "  background: rgba(13, 71, 110, 0.9); color: #e8f2fa;" +
            "  border: 2px solid rgba(255, 255, 255, 0.35);" +
            "  font: bold 3.4vmin/1.2 sans-serif; display: none; touch-action: none;" +
            "  -webkit-user-select: none; user-select: none;" +
            "  -webkit-tap-highlight-color: transparent;" +
            "}" +
            "#tc-privacy {" +
            "  position: fixed; right: 2.5vmin; top: 12.5vmin;" +
            "  z-index: 21; padding: 1.4vmin 3vmin; border-radius: 4vmin;" +
            "  background: rgba(13, 71, 110, 0.9); color: #e8f2fa;" +
            "  border: 2px solid rgba(255, 255, 255, 0.35);" +
            "  font: bold 2.6vmin/1.2 sans-serif; display: none; touch-action: none;" +
            "  -webkit-user-select: none; user-select: none;" +
            "  -webkit-tap-highlight-color: transparent;" +
            "}";
        document.head.appendChild(style);

        removeAdsBtn = document.createElement("div");
        removeAdsBtn.id = "tc-removeads";
        removeAdsBtn.textContent = "Remove Ads - " + priceLabel;
        removeAdsBtn.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            buyRemoveAds();
        });
        swallowTouches(removeAdsBtn);
        document.body.appendChild(removeAdsBtn);

        privacyBtn = document.createElement("div");
        privacyBtn.id = "tc-privacy";
        privacyBtn.textContent = "Privacy Options";
        privacyBtn.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            showPrivacyOptions();
        });
        swallowTouches(privacyBtn);
        document.body.appendChild(privacyBtn);

        // Only show on the title screen, and only while ads are active.
        setInterval(function() {
            var onTitle = window.SceneManager && window.Scene_Title &&
                          SceneManager._scene instanceof Scene_Title;
            removeAdsBtn.style.display = (onTitle && !adsRemoved) ? "block" : "none";
            privacyBtn.style.display = (onTitle && !adsRemoved && privacyRequired) ? "block" : "none";
        }, 400);
    }

    // ---- localized price -----------------------------------------------
    // Play charges in the player's own currency, so ask the store for the
    // real display price instead of showing the hardcoded USD label.
    function fetchPrice() {
        if (!Purchases || !Purchases.getProduct) return;
        billing(function() {
            return Purchases.getProduct({
                productIdentifier: CFG.removeAdsProductId,
                productType: "inapp"
            });
        }, QUERY_TIMEOUT_MS).then(function(res) {
            var p = res && (res.product || res);
            if (p && p.priceString) {
                priceLabel = p.priceString;
                if (removeAdsBtn) {
                    removeAdsBtn.textContent = "Remove Ads - " + priceLabel;
                }
                refreshMenuCommands();
            }
        }).catch(function(e) {
            // Product not published yet, or offline: keep the config label.
            console.warn("getProduct failed:", e && e.message);
        });
    }

    // ---- "Remove Ads" entry in the in-game menu --------------------------
    // Added as a real menu command (not an overlay) so it matches the game's
    // own UI and never covers anything. Aliases are installed once the engine
    // classes exist - MZ loads its scripts asynchronously after this file.
    function patchMenu() {
        var tries = 0;
        var timer = setInterval(function() {
            if (++tries > 1500) { clearInterval(timer); return; }
            if (!window.Window_MenuCommand || !window.Scene_Menu) { return; }
            clearInterval(timer);
            try {
                var makeList = Window_MenuCommand.prototype.makeCommandList;
                Window_MenuCommand.prototype.makeCommandList = function() {
                    makeList.call(this);
                    if (adsRemoved) { return; }
                    var added = 1;
                    this.addCommand("Remove Ads - " + priceLabel, "removeAds", true);
                    if (privacyRequired) {
                        this.addCommand("Privacy Options", "privacyOptions", true);
                        added = 2;
                    }
                    // Sit above "Game End" instead of dangling below it.
                    var list = this._list;
                    for (var i = 0; i < list.length; i++) {
                        if (list[i].symbol === "gameEnd") {
                            var ours = list.splice(list.length - added, added);
                            Array.prototype.splice.apply(list, [i, 0].concat(ours));
                            break;
                        }
                    }
                };
                var createCmd = Scene_Menu.prototype.createCommandWindow;
                Scene_Menu.prototype.createCommandWindow = function() {
                    createCmd.call(this);
                    this._commandWindow.setHandler("removeAds", function() {
                        buyRemoveAds();
                        var scene = SceneManager._scene;
                        if (scene && scene._commandWindow) {
                            scene._commandWindow.activate();
                        }
                    });
                    this._commandWindow.setHandler("privacyOptions", function() {
                        showPrivacyOptions();
                        var scene = SceneManager._scene;
                        if (scene && scene._commandWindow) {
                            scene._commandWindow.activate();
                        }
                    });
                };
            } catch (e) {
                console.warn("Menu patch failed:", e && e.message);
            }
        }, 10);
    }

    // ---- first ad request on the first map scene -------------------------
    // The title screen is where launches that never become sessions end, so
    // nothing is requested there. Scene_Map starts for New Game and Continue
    // alike; prepareNext's own guards (adReady, adLoading, adsRemoved) make
    // every later map start a no-op, and initAds' adsStarted/mapReached make
    // the order of "SDK ready" and "map reached" irrelevant.
    function patchMap() {
        var tries = 0;
        var timer = setInterval(function() {
            if (++tries > 1500) { clearInterval(timer); return; }
            if (!window.Scene_Map) { return; }
            clearInterval(timer);
            try {
                var startMap = Scene_Map.prototype.start;
                Scene_Map.prototype.start = function() {
                    startMap.call(this);
                    if (!mapReached) {
                        mapReached = true;
                        adDebug("first map scene - requesting the first interstitial");
                    }
                    if (adsStarted) prepareNext();
                };
            } catch (e) {
                console.warn("Map patch failed:", e && e.message);
            }
        }, 10);
    }

    // ---- ad break on returning to the title screen -----------------------
    // The first title screen is app start - no ads on launch (AdMob policy).
    // Every later one ("To Title" from the menu, game over, the ending) shows
    // an ad regardless of the cooldown, as long as one is loaded.
    function patchTitle() {
        var tries = 0;
        var timer = setInterval(function() {
            if (++tries > 1500) { clearInterval(timer); return; }
            if (!window.Scene_Title) { return; }
            clearInterval(timer);
            try {
                var titleVisits = 0;
                var startTitle = Scene_Title.prototype.start;
                Scene_Title.prototype.start = function() {
                    startTitle.call(this);
                    // A consent form that had to wait gets its turn here.
                    startAds();
                    if (++titleVisits > 1) {
                        adDebug("back on the title screen - ad break (no cooldown)");
                        window.showAdBreak({ force: true });
                    }
                };
            } catch (e) {
                console.warn("Title patch failed:", e && e.message);
            }
        }, 10);
    }

    if (CFG.testAds) {
        window.__adsDebug = {
            reset: function() {
                adsRemoved = true; // so clearAdsRemoved() does the full reset
                clearAdsRemoved("debug reset");
            },
            break: function() { window.showAdBreak(); },
            consentTest: function(hash) {
                try { localStorage.setItem(CONSENT_DEBUG_KEY, hash); } catch (e) { /* ignore */ }
                return AdMob.resetConsentInfo();
            },
            consentOff: function() {
                try { localStorage.removeItem(CONSENT_DEBUG_KEY); } catch (e) { /* ignore */ }
                return AdMob.resetConsentInfo();
            }
        };
    }

    function start() {
        adDebug("AdMob plugin " + (AdMob ? "found" : "MISSING") +
                ", billing " + (Purchases ? "found" : "missing") +
                (adsRemoved ? ", ads removed (saved on device)" : ""));
        buildButton();
        patchMenu();
        patchTitle();
        patchMap();
        // Ask Play who owns what before anything else: consent is asked for and
        // AdMob started only once Play has answered and the player does not own
        // remove-ads; the first ad is requested on the first map scene
        // (patchMap). If the check fails it retries; ads stay on meanwhile
        // unless the device remembers a purchase.
        checkOwned().then(function() {
            playAsked = true;
            startAds();
            fetchPrice();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
    } else {
        start();
    }
})();
