/*
 * monetization.js - AdMob interstitials + "remove ads" purchase.
 *
 * Active only when MOBILE_CONFIG.ads is true AND running inside the native
 * app (never on itch web/desktop). Everything is driven by two hooks:
 *
 *   window.showAdBreak()  - call from an RPG Maker event (Script command:
 *                           `window.showAdBreak && window.showAdBreak();`)
 *                           at natural break points (end of each day).
 *                           No-op if ads were removed, an ad isn't loaded
 *                           yet (e.g. offline), or ads are disabled.
 *                           Games exported for the Game Monetize portal
 *                           call `window.sdk.showBanner()` at their ad
 *                           breaks instead; inside the app that object is
 *                           provided here and routes to showAdBreak(), so
 *                           one export serves both the portal and Play.
 *
 *   While the native interstitial is up the game loop is stopped and the
 *   audio context suspended, then both resume when it is dismissed - the
 *   event that triggered the break continues exactly where it left off.
 *
 *   TEST-ads builds (MOBILE_CONFIG.testAds) show a small status line at the
 *   bottom of the screen with what the ad pipeline is doing - init, load,
 *   show results and why an ad break was skipped - since a phone has no
 *   console. Release builds never show it.
 *
 *   window.buyRemoveAds() - starts the purchase flow. Wired to the title
 *                           screen button; also callable from the console.
 *
 * Ownership of the remove-ads product is re-checked against Google Play on
 * every launch (getPurchases), with localStorage as the offline cache. When
 * Play answers and the product is NOT owned any more (refunded or revoked
 * order), the cache is dropped and ads come back; when Play cannot be
 * reached the cache stands, so a paying player offline stays ad-free.
 *
 * TEST-ads builds also expose window.__adsDebug = { reset(), break() } so
 * the ad pipeline can be driven from a DevTools console: reset() forgets
 * the remove-ads entitlement for this session, break() is an ad break.
 */
(function() {
    "use strict";

    var CFG = window.MOBILE_CONFIG || {};
    var STORAGE_KEY = "tc_ads_removed";

    // Always defined so game event scripts can call it unconditionally.
    window.showAdBreak = function() {};

    var isNative = !!(window.Capacitor && window.Capacitor.isNativePlatform &&
                      window.Capacitor.isNativePlatform());

    // Game Monetize compatibility: the builder strips the portal SDK out of
    // index.html (its ads must not show inside the app), so events that do
    // `window.sdk && window.sdk.showBanner && window.sdk.showBanner();` get
    // the same object with the native interstitial behind it. Defined on
    // every native build so an unguarded sdk.showBanner() never throws on
    // the itch flavor either - there it is just a no-op like showAdBreak.
    if (isNative && !window.sdk) {
        window.sdk = {
            showBanner: function() { window.showAdBreak(); }
        };
    }

    if (!CFG.ads || !isNative) {
        return;
    }

    var Plugins = window.Capacitor.Plugins || {};
    var AdMob = Plugins.AdMob;
    var Purchases = Plugins.NativePurchases;

    var adsRemoved = false;
    try { adsRemoved = localStorage.getItem(STORAGE_KEY) === "1"; } catch (e) { /* ignore */ }
    var adReady = false;
    var prepareAttempts = 0;
    var adShowing = false;
    var lastAdAt = 0;
    // Soft frequency cap: never two ads within this many seconds, even if
    // the game hits two ad breaks back-to-back (e.g. quick scene skips).
    var MIN_GAP_MS = (CFG.minAdIntervalSec || 300) * 1000;
    var removeAdsBtn = null;
    var priceLabel = CFG.removeAdsPriceLabel || "";

    // - test-build status line -
    var debugLines = [];
    var debugEl = null;
    function adDebug(msg) {
        console.log("[ads] " + msg);
        if (!CFG.testAds) return;
        var stamp = new Date().toTimeString().slice(0, 8);
        debugLines.push(stamp + " " + msg);
        if (debugLines.length > 6) debugLines.shift();
        if (!debugEl && document.body) {
            debugEl = document.createElement("div");
            debugEl.id = "tc-addebug";
            debugEl.style.cssText =
                "position:fixed;left:0;bottom:0;z-index:30;max-width:100vw;" +
                "padding:0.6vmin 1.2vmin;background:rgba(0,0,0,0.6);color:#9f9;" +
                "font:2.2vmin/1.3 monospace;white-space:pre;pointer-events:none;";
            document.body.appendChild(debugEl);
        }
        if (debugEl) debugEl.textContent = debugLines.join("\n");
    }

    function setAdsRemoved(reason) {
        adsRemoved = true;
        adDebug("ads removed (" + (reason || "purchase") + ") - no more ad breaks");
        try { localStorage.setItem(STORAGE_KEY, "1"); } catch (e) { /* ignore */ }
        if (removeAdsBtn) {
            removeAdsBtn.style.display = "none";
        }
        refreshMenuCommands();
    }

    // Play no longer reports the product as owned (refund / revoked order):
    // forget the cached entitlement so ads resume.
    function clearAdsRemoved(reason) {
        if (!adsRemoved) return;
        adsRemoved = false;
        try { localStorage.removeItem(STORAGE_KEY); } catch (e) { /* ignore */ }
        adDebug("ads restored (" + reason + ")");
        if (removeAdsBtn) {
            removeAdsBtn.style.display = "";
        }
        refreshMenuCommands();
        prepareNext();
    }

    // Drop the "Remove Ads" entry from an open menu once ads are gone.
    function refreshMenuCommands() {
        try {
            var scene = window.SceneManager && SceneManager._scene;
            if (scene && scene._commandWindow && scene._commandWindow.refresh) {
                scene._commandWindow.refresh();
            }
        } catch (e) { /* ignore */ }
    }

    // - pause/resume game audio while the native ad covers the WebView -
    function suspendAudio() {
        try {
            if (window.WebAudio && WebAudio._context && WebAudio._context.state === "running") {
                WebAudio._context.suspend();
            }
        } catch (e) { /* ignore */ }
    }

    function resumeAudio() {
        try {
            if (window.WebAudio && WebAudio._context && WebAudio._context.state === "suspended") {
                WebAudio._context.resume();
            }
        } catch (e) { /* ignore */ }
    }

    // - freeze the game while the native ad covers it -
    // The interstitial is its own Android activity. The WebView keeps
    // ticking for a few frames before it opens and, on some devices, under
    // it, so everything the event does after the ad break (fade-in, the
    // next scene's dialogue) would play unseen. Stop the engine's game loop
    // (MZ: Graphics.stopGameLoop, MV: SceneManager._stopped) for the ad's
    // duration and restart it on dismissal.
    var gamePaused = false;
    var pauseWatchdog = null;
    // If the SDK never reports the ad as shown (silent failure), do not
    // leave the game frozen: give up after this long and carry on.
    var SHOW_TIMEOUT_MS = 8000;

    function pauseGame() {
        if (gamePaused) return;
        gamePaused = true;
        suspendAudio();
        try {
            if (window.SceneManager && typeof SceneManager.stop === "function") {
                SceneManager.stop();
            }
        } catch (e) { /* ignore */ }
    }

    function resumeGame() {
        if (pauseWatchdog) {
            clearTimeout(pauseWatchdog);
            pauseWatchdog = null;
        }
        if (!gamePaused) return;
        gamePaused = false;
        try {
            if (window.SceneManager && typeof SceneManager.resume === "function") {
                SceneManager.resume();
            }
        } catch (e) { /* ignore */ }
        resumeAudio();
    }

    // - interstitial ads ---------
    function prepareNext() {
        if (adsRemoved || !AdMob) return;
        adDebug("loading interstitial" + (CFG.testAds ? " (test unit)" : "") + "...");
        AdMob.prepareInterstitial({
            adId: CFG.interstitialAdUnitId,
            isTesting: !!CFG.testAds
        }).then(function() {
            adReady = true;
            prepareAttempts = 0;
            adDebug("interstitial loaded - ready for the next ad break");
        }).catch(function(e) {
            adReady = false;
            console.warn("Interstitial failed to load:", e && e.message);
            adDebug("load failed (try " + (prepareAttempts + 1) + "): " + ((e && e.message) || e));
            // Loads fail transiently on some devices (outdated Android System
            // WebView -> "Unable to obtain a JavascriptEngine", flaky network,
            // ad-blocking DNS). Retry with backoff so a later ad break still
            // has an ad ready.
            if (++prepareAttempts <= 5) {
                setTimeout(prepareNext, 30000 * prepareAttempts);
            }
        });
    }

    function initAds() {
        adDebug("AdMob plugin " + (AdMob ? "found" : "MISSING") +
                ", billing " + (Purchases ? "found" : "missing") +
                (adsRemoved ? ", ads removed (saved on device)" : ""));
        if (!AdMob) {
            console.warn("AdMob plugin not available");
            return;
        }
        AdMob.addListener("interstitialAdShowed", function() {
            adShowing = true;
            adDebug("ad is showing");
            // The ad is up: the watchdog is no longer needed, and the game
            // must stay frozen for as long as the ad is on screen.
            if (pauseWatchdog) {
                clearTimeout(pauseWatchdog);
                pauseWatchdog = null;
            }
            pauseGame();
        });
        AdMob.addListener("interstitialAdDismissed", function() {
            adShowing = false;
            adDebug("ad dismissed - game resumed");
            resumeGame();
            prepareNext();
        });
        AdMob.addListener("interstitialAdFailedToShow", function(e) {
            adShowing = false;
            adDebug("show failed: " + ((e && e.message) || JSON.stringify(e)));
            resumeGame();
            prepareNext();
        });
        AdMob.initialize({ initializeForTesting: !!CFG.testAds })
            .then(function() {
                adDebug("AdMob initialized");
                prepareNext();
            })
            .catch(function(e) {
                console.warn("AdMob init failed:", e && e.message);
                adDebug("init failed: " + ((e && e.message) || e));
            });
    }

    window.showAdBreak = function() {
        if (adsRemoved) { adDebug("ad break skipped: ads removed"); return; }
        if (adShowing) { adDebug("ad break skipped: an ad is already showing"); return; }
        if (!AdMob) { adDebug("ad break skipped: AdMob plugin missing"); return; }
        if (Date.now() - lastAdAt < MIN_GAP_MS) {
            adDebug("ad break skipped: last ad " + Math.round((Date.now() - lastAdAt) / 1000) +
                    "s ago, minimum gap " + (MIN_GAP_MS / 1000) + "s");
            return;
        }
        if (!adReady) {
            adDebug("ad break skipped: no interstitial loaded yet - loading for the next one");
            prepareNext(); // try again for the next break (e.g. was offline)
            return;
        }
        adDebug("ad break: showing interstitial");
        adReady = false;
        lastAdAt = Date.now();
        // Freeze right now, before the ad activity opens, so the event that
        // called us does not run on for the frames in between.
        pauseGame();
        pauseWatchdog = setTimeout(function() {
            pauseWatchdog = null;
            if (!adShowing) {
                console.warn("Interstitial never reported as shown; resuming game");
                adDebug("ad never appeared within " + (SHOW_TIMEOUT_MS / 1000) + "s - game resumed");
                resumeGame();
                prepareNext();
            }
        }, SHOW_TIMEOUT_MS);
        AdMob.showInterstitial().catch(function(e) {
            console.warn("Interstitial failed to show:", e && e.message);
            adDebug("show rejected: " + ((e && e.message) || e));
            adShowing = false;
            resumeGame();
            prepareNext();
        });
    };

    // - remove-ads purchase --------
    function checkOwned() {
        if (!Purchases) return;
        Purchases.getPurchases({ productType: "inapp" }).then(function(res) {
            var owned = ((res && res.purchases) || []).some(function(t) {
                return t.productIdentifier === CFG.removeAdsProductId;
            });
            if (owned) {
                setAdsRemoved("remove_ads owned on this Google account");
            } else if (adsRemoved) {
                clearAdsRemoved("Play no longer reports remove_ads as owned");
            } else {
                adDebug("Play purchases checked: remove-ads not owned");
            }
        }).catch(function(e) {
            console.warn("getPurchases failed:", e && e.message);
            adDebug("purchase check failed: " + ((e && e.message) || e));
        });
    }

    function buyRemoveAds() {
        if (!Purchases) {
            alert("Billing is not available on this device.");
            return;
        }
        Purchases.purchaseProduct({
            productIdentifier: CFG.removeAdsProductId,
            productType: "inapp"
        }).then(function() {
            setAdsRemoved("just purchased");
            alert("Ads removed. Thank you for the support!");
        }).catch(function(e) {
            var msg = (e && e.message) || String(e);
            if (/already|owned/i.test(msg)) {
                setAdsRemoved("already owned");
                alert("Purchase restored - ads removed!");
            } else if (!/cancel/i.test(msg)) {
                alert("Purchase failed: " + msg);
            }
        });
    }
    window.buyRemoveAds = buyRemoveAds;

    // - title-screen "Remove Ads" button -------
    function buildButton() {
        var style = document.createElement("style");
        style.textContent =
            "#tc-removeads {" +
            "  position: fixed; right: 2.5vmin; top: 2.5vmin;" +
            "  z-index: 21; padding: 2vmin 4vmin; border-radius: 5vmin;" +
            "  background: rgba(13, 71, 110, 0.9); color: #e8f2fa;" +
            "  border: 2px solid rgba(255, 255, 255, 0.35);" +
            "  font: bold 3.4vmin/1.2 sans-serif; display: none; touch-action: none;" +
            "  -webkit-user-select: none; user-select: none;" +
            "  -webkit-tap-highlight-color: transparent;" +
            "}";
        document.head.appendChild(style);

        removeAdsBtn = document.createElement("div");
        removeAdsBtn.id = "tc-removeads";
        removeAdsBtn.textContent = "Remove Ads - " + priceLabel;
        removeAdsBtn.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            buyRemoveAds();
        });
        ["touchstart", "touchmove", "touchend", "mousedown", "mouseup", "contextmenu"]
            .forEach(function(t) {
                removeAdsBtn.addEventListener(t, function(e) {
                    e.stopPropagation();
                    if (e.cancelable && (t.indexOf("touch") === 0 || t === "contextmenu")) {
                        e.preventDefault();
                    }
                }, { passive: false });
            });
        document.body.appendChild(removeAdsBtn);

        // Only show on the title screen, and only while ads are active.
        setInterval(function() {
            var onTitle = window.SceneManager && window.Scene_Title &&
                          SceneManager._scene instanceof Scene_Title;
            removeAdsBtn.style.display = (onTitle && !adsRemoved) ? "block" : "none";
        }, 400);
    }

    // ---- localized price -----------------------------------------------
    // Play charges in the player's own currency, so ask the store for the
    // real display price instead of showing the hardcoded USD label.
    function fetchPrice() {
        if (!Purchases || !Purchases.getProduct) return;
        Purchases.getProduct({
            productIdentifier: CFG.removeAdsProductId,
            productType: "inapp"
        }).then(function(res) {
            var p = res && (res.product || res);
            if (p && p.priceString) {
                priceLabel = p.priceString;
                if (removeAdsBtn) {
                    removeAdsBtn.textContent = "Remove Ads - " + priceLabel;
                }
                refreshMenuCommands();
            }
        }).catch(function(e) {
            // Product not published yet, or offline: keep the config label.
            console.warn("getProduct failed:", e && e.message);
        });
    }

    // ---- "Remove Ads" entry in the in-game menu --------------------------
    // Added as a real menu command (not an overlay) so it matches the game's
    // own UI and never covers anything. Aliases are installed once the engine
    // classes exist - MZ loads its scripts asynchronously after this file.
    function patchMenu() {
        var tries = 0;
        var timer = setInterval(function() {
            if (++tries > 1500) { clearInterval(timer); return; }
            if (!window.Window_MenuCommand || !window.Scene_Menu) { return; }
            clearInterval(timer);
            try {
                var makeList = Window_MenuCommand.prototype.makeCommandList;
                Window_MenuCommand.prototype.makeCommandList = function() {
                    makeList.call(this);
                    if (adsRemoved) { return; }
                    this.addCommand("Remove Ads - " + priceLabel, "removeAds", true);
                    // Sit above "Game End" instead of dangling below it.
                    var list = this._list;
                    for (var i = 0; i < list.length; i++) {
                        if (list[i].symbol === "gameEnd") {
                            list.splice(i, 0, list.pop());
                            break;
                        }
                    }
                };
                var createCmd = Scene_Menu.prototype.createCommandWindow;
                Scene_Menu.prototype.createCommandWindow = function() {
                    createCmd.call(this);
                    this._commandWindow.setHandler("removeAds", function() {
                        buyRemoveAds();
                        var scene = SceneManager._scene;
                        if (scene && scene._commandWindow) {
                            scene._commandWindow.activate();
                        }
                    });
                };
            } catch (e) {
                console.warn("Menu patch failed:", e && e.message);
            }
        }, 10);
    }

    if (CFG.testAds) {
        window.__adsDebug = {
            reset: function() {
                adsRemoved = true; // so clearAdsRemoved() does the full reset
                clearAdsRemoved("debug reset");
            },
            break: function() { window.showAdBreak(); }
        };
    }

    function start() {
        initAds();
        checkOwned();
        buildButton();
        fetchPrice();
        patchMenu();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
    } else {
        start();
    }
})();
