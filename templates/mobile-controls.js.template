/*
 * mobile-controls.js - Android/WebView additions for the RPG Maker MZ export.
 * Generated by RMMZ APK Builder.
 *
 * 1. Forces PIXI to compile fragment shaders at highp precision (mobile GPUs
 *    run mediump at real 16-bit floats, causing tile seams / garbled tiles).
 * 2. Input shield: stops the engine's document-level touch handlers from
 *    reacting to touches on UI overlays.
 * 3. Nudges the engine to recompute the canvas scale after the WebView
 *    viewport settles.
 * 4. On-screen touch controls: d-pad (move), Z (OK), X (menu/cancel),
 *    SHIFT (dash), writing into Input._currentState like the keyboard does.
 * 5. Android back button = X (menu/cancel) via the @capacitor/app plugin.
 */
(function() {
    "use strict";

    // --- 1. Renderer fix: run as soon as pixi.js registers ------------------
    var precisionTimer = setInterval(function() {
        if (window.PIXI && PIXI.settings) {
            clearInterval(precisionTimer);
            try {
                PIXI.settings.PRECISION_FRAGMENT = "highp";
                PIXI.settings.ROUND_PIXELS = true;
            } catch (e) {
                console.error("PIXI settings patch failed:", e);
            }
        }
    }, 5);

    // --- 1b. Game window vertical margin -------------------------------------
    // On phones the engine renders the game at 90% of the screen height
    // (Graphics._stretchHeight applies a 0.9 rate). GAME_VMARGIN replaces
    // that with an exact per-side fraction: 0 = full screen height,
    // 0.05 = the engine's default look, bigger = more frame visible.
    var GAME_VMARGIN = {{GAME_VMARGIN}};
    var stretchTries = 0;
    var stretchTimer = setInterval(function() {
        if (++stretchTries > 1500) { clearInterval(stretchTimer); return; }
        if (!window.Graphics) { return; }
        if (Graphics._stretchHeight) {
            // MZ: replace the engine's mobile 0.9 rate with the exact margin.
            clearInterval(stretchTimer);
            Graphics._stretchHeight = function() {
                return document.documentElement.clientHeight * (1 - 2 * GAME_VMARGIN);
            };
            try {
                if (Graphics._app) { Graphics._updateAllElements(); }
            } catch (e) { /* not booted yet - the resize nudges cover it */ }
        } else if (Graphics._updateRealScale) {
            // MV: no _stretchHeight and no built-in mobile margin; rebuild
            // the scale computation with the margin applied to the height.
            clearInterval(stretchTimer);
            Graphics._updateRealScale = function() {
                if (this._stretchEnabled) {
                    var h = window.innerWidth / this._width;
                    var v = (window.innerHeight * (1 - 2 * GAME_VMARGIN)) / this._height;
                    if (h >= 1 && h - 0.01 <= 1) h = 1;
                    if (v >= 1 && v - 0.01 <= 1) v = 1;
                    this._realScale = Math.min(h, v);
                } else {
                    this._realScale = this._scale;
                }
            };
            try { Graphics._updateAllElements(); } catch (e) { /* not booted yet */ }
        }
    }, 10);

    // --- 2. Input shield -----------------------------------------------------
    // Element ids cover both engines: MZ (gameCanvas/gameVideo) and
    // MV (GameCanvas/GameVideo/UpperCanvas/ErrorPrinter).
    var GAME_IDS = ["gameCanvas", "gameVideo", "game-frame",
                    "GameCanvas", "GameVideo", "UpperCanvas", "ErrorPrinter"];
    function isGameTarget(t) {
        return t === document || t === document.documentElement ||
               t === document.body ||
               (t && t.id && GAME_IDS.indexOf(t.id) >= 0);
    }

    ["touchstart", "touchmove", "touchend", "touchcancel",
     "mousedown", "mousemove", "mouseup", "wheel"].forEach(function(type) {
        document.addEventListener(type, function(e) {
            if (!isGameTarget(e.target)) {
                e.stopImmediatePropagation();
            }
        }, { passive: false });
    });

    ["keydown", "keyup", "keypress"].forEach(function(type) {
        document.addEventListener(type, function(e) {
            var t = e.target;
            var isField = t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" ||
                                t.isContentEditable);
            if (isField) {
                e.stopImmediatePropagation();
            }
        }, { passive: false });
    });

    // --- 3. Re-sync canvas scale after the viewport settles -----------------
    window.addEventListener("load", function() {
        [300, 1000, 2500].forEach(function(ms) {
            setTimeout(function() {
                window.dispatchEvent(new Event("resize"));
            }, ms);
        });
    });

    if (!("ontouchstart" in window)) {
        return;
    }

    // --- 4. On-screen controls ----------------------------------------------
    var CSS = [
        "#tc-root, #tc-root * {",
        "  box-sizing: border-box;",
        "  -webkit-user-select: none; user-select: none;",
        "  -webkit-tap-highlight-color: transparent;",
        "}",
        "#tc-dpad {",
        "  position: fixed; left: 3vmin; bottom: 8vmin;",
        "  width: calc(42vmin * {{SCALE}}); height: calc(42vmin * {{SCALE}});",
        "  max-width: 340px; max-height: 340px;",
        "  z-index: 20; touch-action: none; opacity: {{OPACITY}};",
        "}",
        ".tc-arm {",
        "  position: absolute; background: {{BTN_COLOR}}; border-radius: 2.2vmin;",
        "}",
        ".tc-arm.h { left: 0; top: 33.5%; width: 100%; height: 33%; }",
        ".tc-arm.v { top: 0; left: 33.5%; height: 100%; width: 33%; }",
        "#tc-buttons {",
        "  position: fixed; right: 3vmin; bottom: 8vmin; z-index: 20;",
        "  display: grid; grid-template-columns: repeat(2, calc(16vmin * {{SCALE}}));",
        "  grid-auto-rows: calc(16vmin * {{SCALE}});",
        "  gap: 3vmin; touch-action: none; opacity: {{OPACITY}};",
        "}",
        ".tc-btn {",
        "  background: {{BTN_COLOR_RGBA}}; color: #f0f4f8;",
        "  border: 2px solid rgba(255, 255, 255, 0.35); border-radius: 2.5vmin;",
        "  display: flex; align-items: center; justify-content: center;",
        "  font: bold calc(5.5vmin * {{SCALE}})/1.1 sans-serif; text-align: center;",
        "  touch-action: none;",
        "}",
        ".tc-btn.small { font-size: calc(3.6vmin * {{SCALE}}); }",
        ".tc-pressed { filter: brightness(1.7); }",
        "#tc-toggle {",
        "  position: fixed; left: 50%; bottom: 1vmin; transform: translateX(-50%);",
        "  width: 7vmin; height: 7vmin; max-width: 46px; max-height: 46px;",
        "  background: rgba(20, 20, 20, 0.5); color: #dddddd;",
        "  border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 50%;",
        "  display: flex; align-items: center; justify-content: center;",
        "  font: bold 4.5vmin/1 sans-serif; z-index: 21; touch-action: none;",
        "}",
        ".tc-hidden { display: none !important; }"
    ].join("\n");

    var EXTRA_ENABLED = {{EXTRA_ENABLED}};
    var EXTRA_KEY = "{{EXTRA_KEY}}";
    var EXTRA_CODE = {{EXTRA_CODE}};

    function press(name, on) {
        if (window.Input && Input._currentState) {
            Input._currentState[name] = !!on;
        }
    }

    function tap(name) {
        press(name, true);
        setTimeout(function() { press(name, false); }, 100);
    }

    // For the extra button: send a real keyboard event so the engine (or any
    // plugin keymap) resolves the key itself, mapped or not.
    function sendKey(type, keyCode) {
        var e = new KeyboardEvent(type, { bubbles: true, cancelable: true });
        Object.defineProperty(e, "keyCode", { get: function() { return keyCode; } });
        Object.defineProperty(e, "which", { get: function() { return keyCode; } });
        document.dispatchEvent(e);
    }

    function bindKeyButton(el, keyCode) {
        var down = false;
        el.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            try { el.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
            down = true;
            el.classList.add("tc-pressed");
            sendKey("keydown", keyCode);
        });
        function release(e) {
            if (!down) return;
            e.stopPropagation();
            down = false;
            el.classList.remove("tc-pressed");
            sendKey("keyup", keyCode);
        }
        el.addEventListener("pointerup", release);
        el.addEventListener("pointercancel", release);
        blockNative(el);
    }

    function blockNative(el) {
        var types = ["touchstart", "touchmove", "touchend", "touchcancel",
                     "mousedown", "mousemove", "mouseup", "contextmenu"];
        types.forEach(function(type) {
            el.addEventListener(type, function(e) {
                e.stopPropagation();
                if (e.cancelable && (type.indexOf("touch") === 0 || type === "contextmenu")) {
                    e.preventDefault();
                }
            }, { passive: false });
        });
    }

    function bindButton(el, name) {
        var down = false;
        el.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            try { el.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
            down = true;
            el.classList.add("tc-pressed");
            press(name, true);
        });
        function release(e) {
            if (!down) return;
            e.stopPropagation();
            down = false;
            el.classList.remove("tc-pressed");
            press(name, false);
        }
        el.addEventListener("pointerup", release);
        el.addEventListener("pointercancel", release);
        blockNative(el);
    }

    var DIRS = ["up", "down", "left", "right"];

    function bindDpad(pad) {
        var pointerId = null;

        function apply(active) {
            DIRS.forEach(function(d) {
                press(d, active.indexOf(d) >= 0);
            });
        }

        function update(e) {
            var rect = pad.getBoundingClientRect();
            var dx = e.clientX - (rect.left + rect.width / 2);
            var dy = e.clientY - (rect.top + rect.height / 2);
            if (Math.sqrt(dx * dx + dy * dy) < rect.width * 0.10) {
                apply([]);
                return;
            }
            var deg = Math.atan2(dy, dx) * 180 / Math.PI;
            var active;
            if (deg > -22.5 && deg <= 22.5)        active = ["right"];
            else if (deg > 22.5 && deg <= 67.5)    active = ["down", "right"];
            else if (deg > 67.5 && deg <= 112.5)   active = ["down"];
            else if (deg > 112.5 && deg <= 157.5)  active = ["down", "left"];
            else if (deg > -67.5 && deg <= -22.5)  active = ["up", "right"];
            else if (deg > -112.5 && deg <= -67.5) active = ["up"];
            else if (deg > -157.5 && deg <= -112.5) active = ["up", "left"];
            else                                    active = ["left"];
            apply(active);
        }

        pad.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            try { pad.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
            pointerId = e.pointerId;
            update(e);
        });
        pad.addEventListener("pointermove", function(e) {
            if (e.pointerId === pointerId) {
                e.stopPropagation();
                update(e);
            }
        });
        function release(e) {
            if (e.pointerId !== pointerId) return;
            e.stopPropagation();
            pointerId = null;
            apply([]);
        }
        pad.addEventListener("pointerup", release);
        pad.addEventListener("pointercancel", release);
        blockNative(pad);
    }

    // --- 5. Android back button = X (menu/cancel) ---------------------------
    function setupBackButton() {
        var C = window.Capacitor;
        if (C && C.Plugins && C.Plugins.App && C.Plugins.App.addListener) {
            C.Plugins.App.addListener("backButton", function() {
                tap("escape");
            });
            return true;
        }
        return false;
    }
    if (!setupBackButton()) {
        window.addEventListener("load", setupBackButton);
    }

    function build() {
        var style = document.createElement("style");
        style.textContent = CSS;
        document.head.appendChild(style);

        var root = document.createElement("div");
        root.id = "tc-root";

        var pad = document.createElement("div");
        pad.id = "tc-dpad";
        var armH = document.createElement("div");
        armH.className = "tc-arm h";
        var armV = document.createElement("div");
        armV.className = "tc-arm v";
        pad.appendChild(armH);
        pad.appendChild(armV);
        bindDpad(pad);
        root.appendChild(pad);

        var buttons = document.createElement("div");
        buttons.id = "tc-buttons";
        if (EXTRA_ENABLED) {
            var extra = document.createElement("div");
            extra.className = "tc-btn" + (EXTRA_KEY.length > 1 ? " small" : "");
            extra.textContent = EXTRA_KEY;
            extra.style.gridColumn = "1";
            bindKeyButton(extra, EXTRA_CODE);
            buttons.appendChild(extra);
        }
        [
            { label: "Z", name: "ok", col: 2, small: false },
            { label: "SHIFT", name: "shift", col: 1, small: true },
            { label: "X", name: "escape", col: 2, small: false }
        ].forEach(function(def) {
            var el = document.createElement("div");
            el.className = "tc-btn" + (def.small ? " small" : "");
            el.textContent = def.label;
            el.style.gridColumn = String(def.col);
            bindButton(el, def.name);
            buttons.appendChild(el);
        });
        root.appendChild(buttons);

        // Controls start hidden behind a small "+" button (bottom center);
        // pressing it shows them and turns it into a minus. The choice is
        // remembered between sessions.
        var controlsVisible = false;
        try { controlsVisible = localStorage.getItem("tc_controls_visible") === "1"; } catch (e) { /* ignore */ }

        var toggle = document.createElement("div");
        toggle.id = "tc-toggle";

        function applyVisibility() {
            if (controlsVisible) {
                pad.classList.remove("tc-hidden");
                buttons.classList.remove("tc-hidden");
                toggle.textContent = "\u2212";
            } else {
                pad.classList.add("tc-hidden");
                buttons.classList.add("tc-hidden");
                toggle.textContent = "+";
            }
        }

        toggle.addEventListener("pointerdown", function(e) {
            e.preventDefault();
            e.stopPropagation();
            controlsVisible = !controlsVisible;
            try { localStorage.setItem("tc_controls_visible", controlsVisible ? "1" : "0"); } catch (e2) { /* ignore */ }
            if (!controlsVisible) {
                // release anything still held when hiding mid-press
                DIRS.forEach(function(d) { press(d, false); });
                press("ok", false); press("escape", false); press("shift", false);
            }
            applyVisibility();
        });
        blockNative(toggle);
        root.appendChild(toggle);
        applyVisibility();

        document.body.appendChild(root);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", build);
    } else {
        build();
    }
})();
